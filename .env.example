TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
LOG_LEVEL=INFO

# Optional: Instagram authentication.
# Run `uv run python scripts/export_instagram_cookies.py` to generate the cookies file
# from your username/password, then set INSTAGRAM_COOKIES_FILE to that path.
#
# Recommended: use a burner Instagram account, not your main one.
# 2FA-protected accounts: disable 2FA temporarily to run the export script, then re-enable.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
# INSTAGRAM_SESSION_FILE=  (legacy, no longer used)
INSTAGRAM_COOKIES_FILE=instagram-cookies.txt
