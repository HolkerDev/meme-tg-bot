# Required to run the bot. Get this token from @BotFather.
TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
# Optional bot settings.
LOG_LEVEL=INFO
DB_PATH=meme_nova.db

# Instagram: see docs/instagram.md
#
# Videos (yt-dlp) use Chrome TLS impersonation — no cookies.
# Photos (gallery-dl) need a Netscape cookies file from a browser session:
#   uv run yt-dlp --cookies-from-browser chrome --cookies instagram-cookies.txt \
#     --skip-download "https://www.instagram.com/"
# Prefer a burner account. Absolute path recommended on the bot host.
#
# INSTAGRAM_USERNAME / INSTAGRAM_PASSWORD: only for scripts/export_instagram_cookies.py
# (fragile; Instagram often requires a security checkpoint). Prefer browser export.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
# INSTAGRAM_SESSION_FILE=  (legacy, unused)
INSTAGRAM_COOKIES_FILE=instagram-cookies.txt

# Raspberry Pi SSH (local LAN). PI_SSH_PASSWORD is needed to inspect the Pi
# when SSH key authentication is unavailable. Keep the filled-in .env private.
# See .cursor/skills/ssh-pi/SKILL.md
PI_SSH_HOST=192.168.0.8
PI_SSH_USER=holker
PI_SSH_PASSWORD=
